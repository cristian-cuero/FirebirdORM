      "source_location": "DECISIONS.md:L24-L35",
      "_origin": "semantic"
    },
    {
      "id": "decision:versions-supported",
      "type": "decision",
      "label": "Supported Versions: Node ≥18 LTS, Firebird 3.0+",
      "description": "Node.js 18+ LTS (ESM native, fetch, crypto); Firebird 3.0+ full support (4.0/5.0); 2.5 best-effort; auto-detect version on connect",
      "source_location": "DECISIONS.md:L39-L54",
      "_origin": "semantic"
    },
    {
      "id": "decision:pk-strategy",
      "type": "decision",
      "label": "Primary Key Strategy: Auto-detect IDENTITY/Generator",
      "description": "Auto-detect IDENTITY columns (FB4+) else Generator+Trigger (FB2.5/3); RETURNING clause for FB2.1+",
      "source_location": "DECISIONS.md:L56-L70",
      "_origin": "semantic"
    },
    {
      "id": "decision:sql-injection",
