    },
    {
      "id": "concept:roadmap",
      "type": "concept",
      "label": "10-Phase Development Roadmap",
      "description": "Phase 0: Foundation; Phase 1: Connection; Phase 2: Models; Phase 3: Query/CRUD; Phase 4: Associations; Phase 5: Transactions+Hooks; Phase 6: Migrations; Phase 7: Native SQL; Phase 8: Testing+Docs; Phase 9: Build+Publish",
      "source_location": "CLAUDE.md:L70-L84",
